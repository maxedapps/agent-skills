{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video-editing/keep-list.schema.json",
  "title": "Tutorial take keep-list",
  "type": "object",
  "required": ["keeps"],
  "additionalProperties": true,
  "$defs": {
    "acceptedPause": {
      "type": "object",
      "required": ["start", "end", "reason"],
      "additionalProperties": true,
      "properties": {
        "start": {
          "type": "number",
          "minimum": 0,
          "description": "Pause start on the source timeline; build_filter maps it to output time"
        },
        "end": { "type": "number", "minimum": 0 },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "source": { "type": "string" },
    "output": { "type": "string" },
    "source_duration_s": { "type": "number", "minimum": 0 },
    "pad_in": {
      "type": "number",
      "minimum": 0,
      "default": 0.03,
      "description": "Global tiny fallback only; explicit per-keep pad_in overrides it"
    },
    "pad_out": {
      "type": "number",
      "minimum": 0,
      "default": 0.05,
      "description": "Global tiny fallback only; explicit per-keep pad_out overrides it"
    },
    "merge_gap": { "type": "number", "minimum": 0, "default": 0.15 },
    "accepted_pauses": {
      "type": "array",
      "description": "Reviewed source-timeline internal pauses retained intentionally; not a silence-delete list",
      "items": { "$ref": "#/$defs/acceptedPause" }
    },
    "keeps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["start", "end"],
        "additionalProperties": true,
        "properties": {
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "minimum": 0 },
          "note": { "type": "string" },
          "join": {
            "type": "string",
            "enum": ["repair", "continuation", "sentence", "section"],
            "description": "Semantic intent AFTER this keep; independent of source gap and edge hygiene"
          },
          "pause": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "intent": {
                "type": "string",
                "enum": ["short", "retained"],
                "description": "Desired outgoing cadence on the assembled timeline"
              },
              "accepted": {
                "type": "boolean",
                "description": "True only after listening to an intentionally retained pause"
              },
              "reason": { "type": "string", "minLength": 1 },
              "tolerance": { "type": "number", "minimum": 0 }
            },
            "allOf": [
              {
                "if": {
                  "required": ["accepted"],
                  "properties": { "accepted": { "const": true } }
                },
                "then": {
                  "required": ["intent", "reason"],
                  "properties": { "intent": { "const": "retained" } }
                }
              }
            ]
          },
          "in": {
            "type": "string",
            "enum": ["tight", "natural"],
            "description": "Incoming edge hygiene; legacy-compatible top-level edge tag"
          },
          "out": {
            "type": "string",
            "enum": ["surgical", "soft", "section"],
            "description": "Outgoing edge hygiene/padding; semantic join intent belongs in join"
          },
          "pad_in": {
            "type": "number",
            "minimum": 0,
            "description": "Optional reviewed override in seconds; overrides class/global in-pad"
          },
          "pad_out": {
            "type": "number",
            "minimum": 0,
            "description": "Optional reviewed override in seconds; overrides class/global out-pad"
          }
        }
      }
    }
  }
}
